# Copy to .env and fill in what you have. Every register without a key is skipped,
# so the tool still runs with none of these set. Never commit your real .env.

# Australia: ABN Lookup GUID (free). https://abr.business.gov.au/Tools/WebServices
ABR_GUID=

# Australia: IP Australia trade marks (free). Create an application on the developer portal,
# then request access to the Australian Trade Mark Search API.
# https://portal.api.ipaustralia.gov.au/s/
IPA_CLIENT_ID=
IPA_CLIENT_SECRET=
# production (default) or test
# IPA_ENV=production

# United Kingdom: Companies House API key (free). https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# New Zealand: NZBN API subscription key (free). https://portal.api.business.govt.nz/
NZBN_SUBSCRIPTION_KEY=
# production (default) or sandbox
# NZBN_ENV=production

# United States: SEC asks every automated client to identify itself with a name and
# contact email in the User-Agent. Use your own, for example: "Your Name you@example.com"
SEC_USER_AGENT=

# Optional: Socrata app token for the US state open-data portals (free). Only needed if you hit throttling.
# SOCRATA_APP_TOKEN=

# Optional: minimum gap between requests to the same host, in milliseconds (default 250)
# BNC_MIN_DELAY_MS=250
